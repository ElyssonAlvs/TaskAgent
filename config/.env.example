# TaskAgent Environment Variables
# Copy to .env and configure

# API Configuration
API_BASE_URL=http://localhost:8000/v1
API_TIMEOUT=5

# LLM Configuration  
LLM_ENDPOINT=http://localhost:11434/v1
LLM_MODEL=mistral
LLM_API_KEY=ollama

# Agent Configuration
AGENT_TIMEOUT=5
AGENT_MAX_RETRIES=1

# Logging
LOG_LEVEL=INFO
LOG_FILE=data/logs/agent.log
